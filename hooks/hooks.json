{
  "description": "interface-craft: routing directive each turn, advisory detector on styled writes, Stop gate on unresolved blocking findings. All fail open; run hooks/test-hooks.mjs to prove they work on this machine.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/route-directive.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/detect-on-write.mjs\"",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/blocking-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
